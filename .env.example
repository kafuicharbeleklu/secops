# SecOps Agent Configuration
# ===========================

# Google Gemini API Key (required for initial version)
GEMINI_API_KEY=your_gemini_api_key_here

# Model Configuration
# Accepted aliases: gemini, gemma, gemma-high, gemma-31b-off, gemma-31b, auto
MODEL_NAME=gemini
# OldSecops-compatible alias:
# GEMINI_MODEL=gemini
MODEL_TEMPERATURE=0.7
MODEL_MAX_TOKENS=8192
# off | auto | on. Auto enables Gemini API Google Search for current/web-sensitive prompts.
GOOGLE_SEARCH_GROUNDING=auto

# Agent Configuration
AGENT_NAME=SecOps Agent
AGENT_VERSION=0.1.0
MAX_TOOL_RETRIES=3
TOOL_TIMEOUT=120

# Ollama Configuration (for future local model support)
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=gemma4

# Logging
LOG_LEVEL=INFO
LOG_FILE=secops_agent.log
