#!/bin/bash
# 🛡️ SecOps Agent - Smart Portable Wrapper
# Ce script détecte si l'environnement est corrompu (déplacement, venv manquant)
# et le répare automatiquement avant le lancement.

PROJECT_ROOT="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
VENV_PATH="$PROJECT_ROOT/.venv"

# --- Fonctions d'interface ---

show_spinner() {
    local pid=$1
    local message=$2
    local delay=0.1
    local spinstr='|/-\'
    
    # Cache le curseur
    tput civis
    
    while kill -0 "$pid" 2>/dev/null; do
        local temp=${spinstr#?}
        printf " \033[34m[%c]\033[0m %s " "$spinstr" "$message"
        local spinstr=$temp${spinstr%"$temp"}
        sleep $delay
        printf "\r"
    done
    
    # Affiche le résultat final et restaure le curseur
    printf " \033[32m[OK]\033[0m %s\n" "$message"
    tput cnorm
}

# --- Logique de vérification ---

check_health() {
    # 1. Le venv existe-t-il ?
    if [ ! -d "$VENV_PATH" ]; then return 1; fi
    
    # 2. L'interpréteur est-il fonctionnel ?
    if [ ! -x "$VENV_PATH/bin/python3" ]; then return 1; fi
    
    # 3. Les dépendances sont-elles toujours liées au bon chemin ?
    # (Test crucial après un déplacement du dossier)
    "$VENV_PATH/bin/python3" -c "import secops_agent" 2>/dev/null
    return $?
}

repair() {
    echo "⚠️  Changement de dossier détecté ou environnement manquant."
    
    # On lance la réparation en arrière-plan
    (
        rm -rf "$VENV_PATH"
        python3 -m venv "$VENV_PATH" >/dev/null 2>&1
        "$VENV_PATH/bin/pip" install -q --upgrade pip
        "$VENV_PATH/bin/pip" install -q -e "$PROJECT_ROOT"
    ) &
    
    REPAIR_PID=$!
    show_spinner "$REPAIR_PID" "Initialisation de l'arsenal SecOps..."
    wait "$REPAIR_PID"
}

# --- Exécution ---

if ! check_health; then
    repair
fi

# Lancement transparent de l'agent
exec "$VENV_PATH/bin/python3" -m secops_agent.main "$@"
